{
  "name": "@ams/plugin-core",
  "version": "1.0.0-rc.1",
  "type": "module",
  "description": "AMS Host plugin: music_ping / music_job_submit tools + Gateway bridge routes (M0.6)",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "README.md"
  ],
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "ams": {
    "pluginId": "ams.plugin.core",
    "kind": "host",
    "pages": [],
    "tools": [
      "music_ping",
      "music_job_submit"
    ],
    "permissions": [
      "network",
      "files.read"
    ],
    "hardened": "M1: bearer/session auth + SSE",
    "features": "M1 pages: train/separate/convert/remix/TTS placeholder + job list/cancel"
  }
}
