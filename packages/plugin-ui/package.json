{
  "name": "@ams/plugin-ui",
  "version": "1.0.0-rc.2",
  "type": "module",
  "description": "AMS Client plugin: full-page AMS console (Gateway health / jobs / progress) + sidebar entry (M0.6)",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "ams": {
    "pluginId": "ams.plugin.ui",
    "kind": "client",
    "pages": [
      "ams.home"
    ],
    "tools": [],
    "permissions": [
      "network"
    ],
    "hardened": "M1: bearer/session auth + SSE",
    "features": "M1 pages: train/separate/convert/remix/TTS placeholder + job list/cancel"
  }
}
